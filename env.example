# Fully qualified domain name of the irods server (use "host.docker.internal" if irods is accessible at localhost)
IRODS_HOST="host.docker.internal"
IRODS_PORT=1247
# Username and password for the iRODS admin user (typically "rods")
IRODS_USER="rods"
IRODS_PASS="rods"

# Path to the irods server certificate
IRODS_SSL_CA_CERTIFICATE_PATH="/path/to/irods/server.crt"

# Secret key for ManGO
MANGO_SECRET_KEY="HV44H6oH-eKMqJDU0W6Xw6ch_c4wpmDWf5tgD0p-0Gc"

# Python module containing SODAR zone configuration
MANGO_IRODS_ZONES_CONFIG="mango_portal.irods_zones_config_bih"

# URL under which ManGO is served (e.g., if behind a reverse proxy)
MANGO_URL_PREFIX="/mango"
